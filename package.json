{
  "name": "dsh-memory-palace",
  "version": "1.0.0",
  "description": "大肥鱼的记忆宫殿：给 DeepSeek Harness 的长期用户记忆插件，增量提取 → 冲突覆盖 → 综合排序召回 → 隔离注入",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "memory",
    "user-memory",
    "context",
    "记忆",
    "大肥鱼"
  ],
  "license": "MIT",
  "author": "大肥鱼",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "demo": "node demo/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22.6"
  },
  "displayName": "大肥鱼的记忆宫殿"
}
